# =============================================================================
# .env.example — AI PR Review Agent
#
# USAGE:
#   cp .env.example .env
#   Fill in every value marked <REPLACE_ME> with your real credentials.
#   Never commit .env — it is in .gitignore.
#
# LOCAL DEV (all-in-one Docker stack):
#   docker compose -f docker-compose.dev.yml up -d
# =============================================================================

# =============================================================================
# GitHub Integration
# =============================================================================

# The secret used to sign every webhook delivery (X-Hub-Signature-256 header).
# Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=<REPLACE_ME>

# Personal Access Token (classic) or fine-grained PAT.
# Scopes needed: contents:read, pull_requests:read+write
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=<REPLACE_ME>

# GitHub REST API base URL. For GHE: https://github.mycompany.com/api/v3
GITHUB_API_BASE_URL=https://api.github.com

# =============================================================================
# Database — PostgreSQL (pgvector)
# =============================================================================

# asyncpg connection URL for PostgreSQL with pgvector extension.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/pr_review_agent

# =============================================================================
# Redis — Job Queue
# =============================================================================

# Redis connection string. For local dev this is set in docker-compose.dev.yml.
REDIS_URL=redis://localhost:6379

# =============================================================================
# LLM Providers (Mistral primary, Google GenAI fallback + embeddings)
# =============================================================================

# Mistral API key — primary model (mistral-small-latest) for all agents.
# Get at: console.mistral.ai
MISTRAL_API_KEY=<REPLACE_ME>

# Google GenAI API key — fallback model (gemini-2.5-flash) and embeddings (gemini-embedding-001).
# Get at: aistudio.google.com/app/apikey
GOOGLE_API_KEY=<REPLACE_ME>

# Embedding model for RAG ingestion (Gemini embedding).
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Primary provider and model configuration
SECURITY_PROVIDER=mistral
SECURITY_MODEL=mistral-small-latest

# =============================================================================
# Application Settings
# =============================================================================

# Environment tag — used in logs and health endpoint.
APP_ENV=production

LOG_LEVEL=INFO

# Maximum number of PR review jobs running concurrently in the worker.
MAX_CONCURRENT_REVIEWS=5

# Minimum confidence score for auto-approval (0.0 - 1.0).
CONFIDENCE_THRESHOLD=0.85

# Seconds before a review workflow is killed and marked timed_out.
WORKFLOW_TIMEOUT_SECONDS=300

# API key for the internal REST endpoints (/api/v1/*).
# Used by the demo script and any external caller.
# Generate: openssl rand -hex 32
API_KEY=<REPLACE_ME>
